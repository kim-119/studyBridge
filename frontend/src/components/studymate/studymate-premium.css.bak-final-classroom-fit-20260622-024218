}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(-6px); }
}

/* =========================================
   스켈레톤 & 로딩
========================================= */
.skeleton-light {
  height: 11px;
  background: linear-gradient(90deg, #f3f4f6 25%, #e9eaec 50%, #f3f4f6 75%);
  background-size: 200% 100%;
  border-radius: 6px;
  margin-bottom: 7px;
  animation: shimmer 1.4s infinite;
}

@keyframes shimmer {
  0%   { background-position: -200% 0; }
  100% { background-position:  200% 0; }
}

/* 타이핑 도트 */
.dt-typing-dots span {
  display: inline-block;
  width: 5px;
  height: 5px;
  background: #60C95A;
  border-radius: 50%;
  margin: 0 2px;
  animation: typing-bounce 1.2s infinite;
}
.dt-typing-dots span:nth-child(2) { animation-delay: 0.2s; }
.dt-typing-dots span:nth-child(3) { animation-delay: 0.4s; }

@keyframes typing-bounce {
  0%, 100% { transform: translateY(0); opacity: 0.5; }
  50%       { transform: translateY(-4px); opacity: 1; }
}

/* =========================================
   채팅 인풋 (Premium)
========================================= */
.chat-input-premium {
  display: flex;
  gap: 10px;
  background: #ffffff;
  border: 1.5px solid #e5e7eb;
  padding: 10px 14px;
  border-radius: 16px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.05);
  transition: border-color 0.2s;
}

.chat-input-premium:focus-within {
  border-color: rgba(96,201,90,0.6);
  box-shadow: 0 2px 16px rgba(96,201,90,0.12);
}

.chat-input-premium input {
  flex: 1;
  background: transparent;
  border: none;
  font-size: 14px;
  outline: none;
  color: #111827;
}

.chat-input-premium input::placeholder {
  color: #9ca3af;
}

.chat-input-premium button {
  background: linear-gradient(135deg, #60C95A, #4ade80);
  color: #fff;
  border: none;
  border-radius: 10px;
  width: 40px;
  height: 40px;
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  transition: all 0.2s;
  box-shadow: 0 2px 8px rgba(96,201,90,0.3);
  flex-shrink: 0;
}

.chat-input-premium button:hover:not(:disabled) {
  transform: scale(1.05);
