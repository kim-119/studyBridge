}

.feedback-btn.detail:hover {
  border-color: #3b82f6;
  background: rgba(59,130,246,0.08);
  color: #2563eb;
}

/* 컨버전스 노드 (최종 답변) */
.tree-convergence-node {
  background: linear-gradient(135deg, rgba(240,253,244,0.95) 0%, rgba(220,252,231,0.95) 100%);
  border: 2px solid #60C95A;
  border-radius: 16px;
  padding: 20px 24px;
  width: 88%;
  z-index: 1;
  position: relative;
  box-shadow: 0 6px 24px rgba(96,201,90,0.18);
  margin-top: 8px;
}

.tree-convergence-node::before {
  content: '';
  position: absolute;
  top: -14px;
  left: 50%;
  transform: translateX(-50%);
  width: 2px;
  height: 14px;
  background: #60C95A;
}

.convergence-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  color: #16a34a;
  font-weight: 800;
  font-size: 14px;
  margin-bottom: 14px;
}

.convergence-content {
  font-size: 14px;
  line-height: 1.75;
  color: #111827;
  white-space: pre-wrap;
}

/* ── 프리미엄 입력창 ── */
.chat-input-premium {
  display: flex;
  align-items: center;
  background: #f8fafc;
  border: 1px solid rgba(0,0,0,0.06);
  border-radius: 20px;
  padding: 4px 6px 4px 16px;
  transition: all 0.2s ease;
}

.chat-input-premium:focus-within {
  background: #ffffff;
  border-color: rgba(96,201,90,0.4);
  box-shadow: 0 4px 12px rgba(96,201,90,0.1);
}

.chat-input-premium input {
  flex: 1;
  border: none;
  background: transparent;
  font-size: 14px;
  color: #111827;
  outline: none;
  padding: 8px 0;
}

.chat-input-premium input::placeholder {
  color: #9ca3af;
}

.chat-input-premium button {
  width: 36px;
  height: 36px;
  border-radius: 14px;
  border: none;
  background: linear-gradient(135deg, #60C95A, #4ade80);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
  box-shadow: 0 2px 8px rgba(96,201,90,0.3);
}

.chat-input-premium button:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(96,201,90,0.4);
}

.chat-input-premium button:disabled {
  background: #e5e7eb;
  color: #9ca3af;
  box-shadow: none;
  cursor: not-allowed;
}

/* 마인드맵 탭 전환 */
.mindmap-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 20px;
  text-align: center;
  color: #9ca3af;
}

.mindmap-empty-icon {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(96,201,90,0.08), rgba(59,130,246,0.08));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
  border: 1.5px dashed rgba(96,201,90,0.3);
