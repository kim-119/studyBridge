# StudyBridge 루트 환경변수 예시 (docker-compose.yml / docker-compose.override.yml / Spring)
# 복사해서 사용: cp .env.example .env   — .env 는 .gitignore 대상이며 절대 커밋하지 않습니다.
# 모든 값은 예시/플레이스홀더입니다. 실제 비밀값을 이 파일에 쓰지 마세요.

# ── 공통 ───────────────────────────────────────────
TZ=Asia/Seoul
DOCKER_IMAGE_PREFIX=studybridge

# ── 인증 (필수) ────────────────────────────────────
# 운영에서는 /home/ubuntu/.studybridge-secrets/spring.env 에 두는 것을 권장
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRATION_MS=1800000

# ── 데이터베이스 ───────────────────────────────────
# 로컬: docker compose up -d db  → DB_HOST=localhost(bootRun) 또는 db(compose spring)
# 운영: AWS RDS 엔드포인트
DB_HOST=localhost
DB_PORT=5432
DB_NAME=capstone
DB_USER=capstone
DB_PASSWORD=change-me
POSTGRES_DB=capstone
POSTGRES_USER=capstone
POSTGRES_PASSWORD=change-me

# ── Redis ─────────────────────────────────────────
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ── AWS S3 (자료·프로필·APK) ───────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=

# ── AI 서버 (FastAPI) ──────────────────────────────
# PRIMARY: ai07 GPU 서버(운영은 reverse SSH tunnel 127.0.0.1:18000), SECONDARY: EC2 :8000
FASTAPI_PRIMARY_BASE_URL=http://localhost:8000
FASTAPI_SECONDARY_BASE_URL=
FASTAPI_TIMEOUT=180000
# Spring 과 FastAPI 양쪽에 같은 값
AI_SERVER_API_KEY=change-me-shared-secret-between-spring-and-fastapi
AI_RECOMMENDATION_ENABLED=false
AI_FEEDBACK_CONCEPT_REVIEW_ENABLED=false

# ── OpenVidu / TURN (그룹 화상) ────────────────────
OPENVIDU_SECRET=change-me
OPENVIDU_DOMAIN_OR_PUBLIC_IP=localhost
OPENVIDU_PUBLICURL=https://localhost:4443
TURN_USERNAME=studybridge
TURN_PASSWORD=change-me
TURN_PUBLIC_IP=127.0.0.1
TURN_PRIVATE_IP=127.0.0.1

# ── SMTP (비밀번호 재설정, 미설정 시 해당 API 503) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=StudyBridge
SMTP_AUTH=true
SMTP_STARTTLS=true

# ── 기타 ─────────────────────────────────────────
BANNER_MCP_TOKEN=
