# /etc/studybridge/ai-overrides.env 에 추가할 값(승인 후). 추가 후 studybridge-ai 재시작 필요.
#
# 0단계(코드 반영만으로 기본 적용 — env 추가 불필요): 출발지 네트워크 가드
#   AI_NETWORK_GUARD=enforce(기본) loopback·사설망은 통과, 그 외 출발지는 Bearer AI_SERVER_API_KEY 필수(GET /health 예외)
#   롤백: AI_NETWORK_GUARD=log(통과+경고) 또는 off. 신뢰 구간 변경: AI_TRUSTED_NETWORKS=127.0.0.0/8,172.16.0.0/12,...
#   Spring 이 모든 AI 호출에 Authorization 을 붙인 뒤에는 AI_NETWORK_GUARD=strict 로 올린다.
# 1단계(코드만, Ollama 설정 그대로): 스케줄링/backpressure/GPU 가드/옵션 정규화 활성
AI_GATEWAY_ENABLED=true
AI_GW_TEXT_SLOTS=1
AI_GW_VISION_SLOTS=1
AI_GW_GPU_GUARD=true
AI_GW_VISION_PRESSURE_POLICY=adaptive
AI_GW_TEXT_FOOTPRINT_MIB=10600
AI_GW_VISION_FOOTPRINT_MIB=4800
AI_GW_VRAM_MARGIN_MIB=768
AI_GW_TEXT_KEEP_ALIVE=30m
# 텍스트가 이 시간 이상 한가할 때만 텍스트를 내리고 VL 을 전량 GPU 로(핑퐁 방지), 재승격 최소 간격
AI_GW_SWAP_IDLE_S=30
AI_GW_REPROMOTE_COOLDOWN_S=60
# GPU 텔레메트리 불명 시: 마지막 정상값 허용 시간, 비전 신규 적재 정책(deny|allow). 텍스트는 항상 허용.
AI_GW_TELEMETRY_STALE_S=10
AI_GW_UNKNOWN_TELEMETRY_VISION=deny
# OpenAI 일 토큰 상한(0 = 관측만). gpt-4o-mini 기준 1,000,000 토큰 ≈ 최대 $0.60/일(단가 재확인 필요)
AI_GW_OPENAI_DAILY_TOKEN_CAP=0
#
# 비전 API(별도 데몬 :11435 상시화 후): 기본 false
# VISION_API_ENABLED=true
#
# 2단계(ollama-tuning.conf.proposed 적용과 동시에): AI_GW_TEXT_SLOTS=2
#
# 3단계(선택, VRAM 확보 — 비전 VL 을 CPU offload 없이 공존시키기 위한 조건, 미검증):
# EMBEDDING_DEVICE=cpu   # e5-base GPU 1.5GB 반환. 실측 비용: 쿼리 2.8→12ms, 청크 32개 0.13→2.9s
#
# 롤백: AI_GATEWAY_ENABLED=false (또는 줄 삭제) 후 재시작 → 모든 추론 호출 경로가 기존과 동일해진다.
