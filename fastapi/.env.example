# ============================================================
# StudyBridge AI Server 환경변수 설정 예시
# 실제 사용 시: cp .env.example .env 후 값 입력
# .env는 절대 Git에 커밋하지 마세요!
# ============================================================

APP_ENV=local
APP_NAME=StudyBridge AI Server
API_PREFIX=/api

# ============================================================
# AI 전용 DB (capstone-db와 완전히 분리)
# ============================================================
# Docker Compose 내부에서 FastAPI → ai-db 컨테이너:
AI_DATABASE_URL=postgresql://studybridge_ai:studybridge_ai_pw@capstone-ai-db:5432/studybridge_ai

# 로컬 PC에서 Docker 밖으로 직접 실행할 때 (호스트 포트 5433):
# AI_DATABASE_URL=postgresql://studybridge_ai:studybridge_ai_pw@localhost:5433/studybridge_ai

# 기존 VECTOR_DATABASE_URL과 하위 호환 (둘 중 하나만 설정해도 됨):
# VECTOR_DATABASE_URL=postgresql://studybridge_ai:studybridge_ai_pw@localhost:5433/studybridge_ai

# ============================================================
# Redis
# ============================================================
# Docker Compose 내부에서:
REDIS_URL=redis://capstone-redis:6379/0

# 로컬 PC에서 Docker 밖으로 직접 실행할 때 (호스트 포트 6380):
# REDIS_URL=redis://localhost:6380/0

# ============================================================
# OpenAI (GPT 검증, 자료보관함 AI, 임베딩)
# ============================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# ============================================================
# Tavily 검색 API
# ============================================================
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic

# ============================================================
# Ollama (로컬 LLM)
# ============================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=30

# ============================================================
# Qwen vLLM (기존 설정 하위 호환)
# ============================================================
QWEN_BASE_URL=http://localhost:8001/v1
QWEN_MODEL_NAME=Qwen/Qwen2.5-14B-Instruct
QWEN_API_KEY=EMPTY

# ============================================================
# Wikipedia
# ============================================================
WIKI_LANGUAGE=ko
WIKI_USER_AGENT=StudyBridge-Capstone/1.0

# ============================================================
# 내부 API 인증 (Spring Boot ↔ FastAPI)
# ============================================================
AI_SERVER_API_KEY=studybridge-internal-secret

# ============================================================
# RAG 파라미터
# ============================================================
RAG_TOP_K=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_MIN_SCORE=0.25

# ============================================================
# AI 응답 타임아웃
# ============================================================
AI_RESPONSE_TIMEOUT_SECONDS=30
AI_VALIDATION_TIMEOUT_SECONDS=20
AI_VALIDATION_ENABLED=true

# ============================================================
# 에이전트 채팅 기본값
# ============================================================
DEFAULT_KNOWLEDGE_LEVEL=학사
DEFAULT_PERSONALITY=친절_설명형
DEFAULT_AGENT_NAME=자바도우미

# ============================================================
# 학습 후보 자동 판정 기준
# ============================================================
TRAINING_AUTO_APPROVE_SCORE=90
TRAINING_HOLDOUT_SCORE=70
