# ============================================================
# StudyBridge FastAPI AI Engine 환경변수 설정 예시
# 실제 사용 시: cp .env.example .env 후 값 입력
# .env는 절대 Git에 커밋하지 마세요!
# ============================================================

APP_ENV=local
APP_NAME=StudyBridge FastAPI AI Engine
API_PREFIX=/api

# ============================================================
# FastAPI 서버 포트 (vLLM이 8000을 점유하면 8001로 변경)
# 서버컴: vLLM → 8000, FastAPI → 8001 분리 운영 권장
# ============================================================
FASTAPI_PORT=8000
# vLLM 사용 시: FASTAPI_PORT=8001

# ============================================================
# OpenAI (GPT 퀴즈 생성, 에이전트 답변, 임베딩)
# ============================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# ============================================================
# Ollama — 주력 LLM 엔진 (Qwen2.5 14B 양자화)
# vLLM 사용 안 함.
# 서버컴에서 `ollama list` 실행 후 실제 모델명으로 변경할 것.
# 16GB VRAM: 14B full precision은 OOM 가능 → 양자화 모델 필수.
# ============================================================
OLLAMA_BASE_URL=http://localhost:11434
# 권장: q4_K_M 양자화 모델 (ollama list로 실제 모델명 확인)
OLLAMA_MODEL=qwen3:14b
# 예시: OLLAMA_MODEL=qwen3:14b-instruct-q4_K_M
OLLAMA_TIMEOUT_SECONDS=45
# 자료보관함 AI 모델 라우팅 (요약=Ollama/Qwen, 로드맵/퀴즈=GPT)
OLLAMA_SUMMARY_MODEL=qwen3:14b
OLLAMA_QA_MODEL=qwen3:14b
# 기능별 hard timeout (전체 120초 예산 내)
AI_SUMMARY_TIMEOUT_SECONDS=90
AI_ROADMAP_TIMEOUT_SECONDS=110
AI_QUIZ_TIMEOUT_SECONDS=90
AI_QA_TIMEOUT_SECONDS=115
AI_GLOBAL_TIMEOUT_SECONDS=120
AI_ENABLE_GPT_FALLBACK=true
AI_ENABLE_RESULT_VALIDATION=true
AI_ENABLE_PDF_TEXT_CACHE=true
# 이미지 기반 PDF OCR (미설치/실패 시 서버는 죽지 않고 PDF_OCR_REQUIRED 반환)
OCR_ENABLED=false
OCR_MAX_PAGES=5
OCR_DPI=180
OCR_LANG=kor+eng
OCR_TIMEOUT_SECONDS=45
# 문서 chunk 분석 (전체 텍스트 일괄 투입 금지) — RDS 영구저장 금지, Redis/in-memory TTL만
AI_CHUNK_CACHE_BACKEND=redis
AI_CHUNK_CACHE_TTL_SECONDS=21600
AI_CHUNK_SIZE=1200
AI_CHUNK_OVERLAP=150
AI_MAX_CHUNKS=80
AI_QA_TOP_K=8
AI_SUMMARY_MAX_CHUNKS=40
AI_ROADMAP_MAX_CHUNKS=30
AI_QUIZ_MAX_CHUNKS=30
# 프론트 AI 요청 timeout (ms)
FRONTEND_AI_TIMEOUT_MS=130000
# (legacy chunk 키 — 하위호환)
DOC_CHUNK_SIZE=1000
DOC_CHUNK_OVERLAP=150
DOC_MAX_CHUNKS=12
OLLAMA_NUM_PREDICT=512
OLLAMA_TEMPERATURE=0.4
OLLAMA_TOP_P=0.9
OLLAMA_CONTEXT_LENGTH=4096
# 전문가/박사 수준 더 긴 응답
OLLAMA_NUM_PREDICT_ADVANCED=768

# ============================================================
# Tavily 검색 API
# ============================================================
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic

# ============================================================
# AWS S3 (PDF 파일 저장소)
# API Key, AWS Key를 코드에 하드코딩하지 않는다.
# ============================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=

# ============================================================
# 학습 시간 예측 모델 경로
# 파일이 없으면 평균 기반 예측(fallback)으로 자동 동작함
# ============================================================
STUDY_TIME_MODEL_PATH=./models/study_time_model

# ============================================================
# AI 응답 타임아웃
# ============================================================
AI_RESPONSE_TIMEOUT_SECONDS=120
QUIZ_GENERATION_TIMEOUT_SECONDS=15
MULTI_CHAT_TIMEOUT_SECONDS=180
AI_VALIDATION_TIMEOUT_SECONDS=30
# 모드별 총 타임아웃 (소크라테스/토론은 단계적 검토로 오래 걸리므로 길게).
# FastAPI(main.py)와 Spring(ChatService)이 동일 키를 참조한다.
AI_DEFAULT_TIMEOUT_SECONDS=90
AI_SOCRATIC_TIMEOUT_SECONDS=240
AI_DEBATE_TIMEOUT_SECONDS=300
AI_MULTI_AGENT_TIMEOUT_SECONDS=300
# Spring → FastAPI WebClient 하드 상한(초). 위 모드별 값보다 크게 둔다.
# application.yml: ai.server.fastapi.read-timeout-seconds 로도 설정 가능.

# ============================================================
# AI 답변 품질 검증 (revise 포함)
# false: validation/revise 완전 skip → 시연 안정성 우선
# true: agent_quality_policy로 품질 검증 및 revise 실행
# ============================================================
AI_VALIDATION_ENABLED=false

# ============================================================
# AI 전용 DB (capstone-db와 완전히 분리)
# ============================================================
AI_DATABASE_URL=postgresql://studybridge_ai:studybridge_ai_pw@capstone-ai-db:5432/studybridge_ai
# 로컬 PC에서 직접 실행 시 (호스트 포트 5433):
# AI_DATABASE_URL=postgresql://studybridge_ai:studybridge_ai_pw@localhost:5433/studybridge_ai

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://capstone-redis:6379/0
# 로컬 PC에서 직접 실행 시 (호스트 포트 6380):
# REDIS_URL=redis://localhost:6380/0

# ============================================================
# 내부 API 인증 (Spring Boot ↔ FastAPI)
# 미설정 시 개발 모드 (인증 스킵)
# ============================================================
AI_SERVER_API_KEY=studybridge-internal-secret

# ============================================================
# Qwen vLLM 서버 — 사용 안 함 (Ollama로 대체됨)
# 아래 설정은 하위 호환을 위해 남겨두되 실제로는 사용되지 않음
# ============================================================
# QWEN_BASE_URL=http://localhost:8001/v1
# QWEN_MODEL_NAME=Qwen/Qwen2.5-14B-Instruct
# QWEN_API_KEY=EMPTY

# ============================================================
# fine-tuned adapter (선택, 기본 비활성)
# QLoRA 실험 성공 후 ollama create한 커스텀 모델명을 입력한다.
# ============================================================
FINETUNED_MODEL_ENABLED=false
# FINETUNED_ADAPTER_PATH=studybridge-qwen25-14b-style
MODEL_ENGINE=ollama

# ============================================================
# OpenAlex (박사 수준 학술 컨텍스트 보강 전용)
# OPENALEX_API_KEY는 없어도 동작하지만 rate limit이 낮아짐
# OPENALEX_ENABLED=false로 비활성화 가능
# ============================================================
OPENALEX_ENABLED=false
OPENALEX_API_KEY=
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_MIN_PUBLICATION_DATE=2020-01-01
OPENALEX_PER_PAGE=3
OPENALEX_TIMEOUT_SECONDS=8
OPENALEX_SORT=cited_by_count:desc
OPENALEX_USE_ONLY_FOR_LEVEL=박사
OPENALEX_EXPOSE_CITATIONS_TO_USER=false

# ============================================================
# Wikipedia
# ============================================================
WIKI_LANGUAGE=ko
WIKI_USER_AGENT=StudyBridge-Capstone/1.0

# ============================================================
# RAG 파라미터
# ============================================================
RAG_TOP_K=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_MIN_SCORE=0.25
RAG_SIMILARITY_THRESHOLD=0.25

# ============================================================
# 학습 후보 자동 판정 기준
# ============================================================
TRAINING_AUTO_APPROVE_SCORE=90
TRAINING_HOLDOUT_SCORE=70

# ============================================================
# 에이전트 기본값
# ============================================================
DEFAULT_KNOWLEDGE_LEVEL=학사
DEFAULT_PERSONALITY=친절_설명형
DEFAULT_AGENT_NAME=자바도우미

# ============================================================
# 멀티 에이전트 응답 제어
# ============================================================
DEFAULT_MAX_AGENTS=3
DEFAULT_ROUNDS=1
MAX_ROUNDS=2
AGENT_ANSWER_MAX_CHARS=450
ADVANCED_AGENT_ANSWER_MAX_CHARS=600
# 답변 잘림 방지 설정
# 사용자에게 보이는 답변 문자 절단 한도. 0이면 절단 비활성화(권장 기본값).
AI_MAX_RESPONSE_CHARS=0
# LLM 생성 토큰 상한 (답변이 중간에 끊기지 않도록 충분히 크게).
AI_ANSWER_MAX_TOKENS=2048
# 로그 미리보기 길이 (실제 응답에는 영향 없음).
AI_LOG_PREVIEW_CHARS=300
PREVIOUS_ANSWERS_LIMIT=20
PREVIOUS_ANSWERS_HARD_LIMIT=100
PREVIOUS_ANSWER_MAX_CHARS=300

# ============================================================
# AWS RDS — AI 전용 DB (production)
# capstone-db는 Spring Boot가 사용. FastAPI는 AI_DATABASE_URL만 사용.
# RDS 사용 예: AI_DATABASE_URL=postgresql://USER:PW@RDS_ENDPOINT:5432/studybridge_ai
# ============================================================
# MAIN_DATABASE_URL=  # 기본적으로 사용하지 않음. Spring이 데이터 주인.
# MAIN_DATABASE_READONLY=true

# ============================================================
# AWS 배포 — Ollama 위치 설정
# EC2 같은 인스턴스: OLLAMA_BASE_URL=http://localhost:11434
# 별도 서버컴 Ollama: OLLAMA_BASE_URL=http://서버컴IP:11434
# ============================================================
# OLLAMA_BASE_URL=http://gpu-server:11434  # AWS 내부망 예시

# ============================================================
# StudyMate Agent Pipeline (1차/2차/3차)
# ============================================================
AGENT_FIRST_PASS_PROVIDER=ollama
AGENT_SECOND_PASS_PROVIDER=openai
AGENT_THIRD_PASS_PROVIDER=openai

AGENT_STAGE1_TIMEOUT_SECONDS=30
AGENT_STAGE2_TIMEOUT_SECONDS=90
AGENT_STAGE3_TIMEOUT_SECONDS=90
AGENT_TOTAL_TIMEOUT_SECONDS=180

AGENT_STAGE1_MAX_TOKENS=700
AGENT_STAGE2_MAX_TOKENS=1200
AGENT_STAGE3_MAX_TOKENS=900

AGENT_ENABLE_PARALLEL_STAGE1=true
AGENT_ENABLE_PARALLEL_STAGE2=true
AGENT_ENABLE_CACHE=true
AGENT_CACHE_TTL_SECONDS=600

AGENT_ENABLE_PERSONALITY_VALIDATION=true
AGENT_PERSONALITY_VALIDATION_MIN_SCORE=0.72
AGENT_PERSONALITY_VALIDATION_MAX_RETRY=1

AGENT_ENABLE_ACCURACY_VALIDATION=true
AGENT_ENABLE_STRUCTURE_VALIDATION=true
AGENT_ENABLE_PERSONA_CONTRAST_CHECK=true

# ============================================================
# Ollama First Pass
# ============================================================
OLLAMA_STAGE1_NUM_PREDICT=700
OLLAMA_STAGE1_TEMPERATURE=0.45
OLLAMA_STAGE1_TOP_P=0.9
OLLAMA_STAGE1_TOP_K=40
OLLAMA_STAGE1_REPEAT_PENALTY=1.08
OLLAMA_STAGE1_TIMEOUT_SECONDS=30

# ============================================================
# Default LLM Parameters
# ============================================================
AGENT_DEFAULT_TEMPERATURE=0.55
AGENT_DEFAULT_TOP_P=0.9
AGENT_DEFAULT_TOP_K=40
AGENT_DEFAULT_REPEAT_PENALTY=1.08
AGENT_DEFAULT_PRESENCE_PENALTY=0.0
AGENT_DEFAULT_FREQUENCY_PENALTY=0.0

# ============================================================
# Personality Parameters (정규 영문 키: friendly/critical/logical/creative/concise)
# 미지정 성격(professional/sardonic/custom)은 AGENT_DEFAULT_* 로 fallback
# ============================================================
AGENT_FRIENDLY_TEMPERATURE=0.65
AGENT_FRIENDLY_TOP_P=0.9
AGENT_FRIENDLY_STRICTNESS=0.35
AGENT_FRIENDLY_CREATIVITY=0.45
AGENT_FRIENDLY_VERBOSITY=0.75
AGENT_FRIENDLY_EMPATHY=0.9
AGENT_FRIENDLY_DIRECTNESS=0.35
AGENT_FRIENDLY_EXAMPLE_DENSITY=0.8
AGENT_FRIENDLY_METAPHOR_DENSITY=0.45

AGENT_CRITICAL_TEMPERATURE=0.45
AGENT_CRITICAL_TOP_P=0.85
AGENT_CRITICAL_STRICTNESS=0.9
AGENT_CRITICAL_CREATIVITY=0.35
AGENT_CRITICAL_VERBOSITY=0.65
AGENT_CRITICAL_EMPATHY=0.45
AGENT_CRITICAL_DIRECTNESS=0.85
AGENT_CRITICAL_EXAMPLE_DENSITY=0.55
AGENT_CRITICAL_METAPHOR_DENSITY=0.25

AGENT_LOGICAL_TEMPERATURE=0.35
AGENT_LOGICAL_TOP_P=0.8
AGENT_LOGICAL_STRICTNESS=0.8
AGENT_LOGICAL_CREATIVITY=0.2
AGENT_LOGICAL_VERBOSITY=0.7
AGENT_LOGICAL_EMPATHY=0.35
AGENT_LOGICAL_DIRECTNESS=0.7
AGENT_LOGICAL_EXAMPLE_DENSITY=0.65
AGENT_LOGICAL_METAPHOR_DENSITY=0.15

AGENT_CREATIVE_TEMPERATURE=0.85
AGENT_CREATIVE_TOP_P=0.95
AGENT_CREATIVE_STRICTNESS=0.5
AGENT_CREATIVE_CREATIVITY=0.95
AGENT_CREATIVE_VERBOSITY=0.8
AGENT_CREATIVE_EMPATHY=0.6
AGENT_CREATIVE_DIRECTNESS=0.45
AGENT_CREATIVE_EXAMPLE_DENSITY=0.75
AGENT_CREATIVE_METAPHOR_DENSITY=0.95

AGENT_CONCISE_TEMPERATURE=0.35
AGENT_CONCISE_TOP_P=0.8
AGENT_CONCISE_STRICTNESS=0.65
AGENT_CONCISE_CREATIVITY=0.2
AGENT_CONCISE_VERBOSITY=0.3
AGENT_CONCISE_EMPATHY=0.35
AGENT_CONCISE_DIRECTNESS=0.9
AGENT_CONCISE_EXAMPLE_DENSITY=0.35
AGENT_CONCISE_METAPHOR_DENSITY=0.1
