# ##################################################################
# DO NOT ENABLE — 2026-09-09 폐기됨
#
# 이 유닛은 studybridge-ai.service 와 같은 :8000 에 바인딩한다.
# 둘 다 enabled 이던 탓에 2026-09-07 22:27 재시작 경합에서 이 구버전
# (main:app, 라우트 43개)이 포트를 선점했고, /api/ai/multi-chat/stream 이
# 404 가 되어 41시간 동안 StudyMate 채팅이 죽었다.
#
# 운영 진입점은 studybridge-ai.service (hotfix_main:app, 라우트 73개) 하나뿐이다.
# 이 파일은 사고 기록용으로만 남긴다. 절대 enable 하지 말 것.
# ##################################################################
# 배포: GitHub Actions cd.yml의 fastapi-deploy 잡이 이 파일을 /etc/systemd/system에 설치/갱신한다.
[Unit]
Description=StudyBridge FastAPI AI server (EC2)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/studyBridge/fastapi
EnvironmentFile=-/home/ubuntu/studyBridge/fastapi/.env
Environment=PYTHONUNBUFFERED=1
# 라이브 엔트리포인트는 항상 hotfix_main:app (= from main import app + /api/ai/multi-chat/stream compat 라우터).
ExecStart=/home/ubuntu/studyBridge/fastapi/.venv/bin/python -m uvicorn hotfix_main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target

# (cd: pkill 자기매칭 회피 위해 fuser -k 포트 기반으로 정리)
