[Unit]
Description=StudyBridge FastAPI AI server (EC2)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/studyBridge/fastapi
EnvironmentFile=-/home/ubuntu/studyBridge/fastapi/.env
Environment=PYTHONUNBUFFERED=1
# 라이브 엔트리포인트는 항상 hotfix_main:app (= from main import app + /api/ai/multi-chat/stream compat 라우터).
ExecStart=/home/ubuntu/studyBridge/fastapi/.venv/bin/python -m uvicorn hotfix_main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
