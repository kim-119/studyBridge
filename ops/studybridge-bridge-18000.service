# Docker 컨테이너(Spring)가 ai07 reverse SSH 터널(127.0.0.1:18000, loopback 전용)에 닿도록
#  docker0 게이트웨이 IP(172.17.0.1:18000)로 socat 브리지를 연다. 설치: ops/install-ai-resilience-units.sh
[Unit]
Description=StudyBridge Docker bridge access to ai07 FastAPI reverse tunnel (172.17.0.1:18000 -> 127.0.0.1:18000)
# 172.17.0.1 은 docker0 가 있어야 bind 가능 → docker 이후 기동(재부팅 시 bind 실패 loop 방지).
After=network-online.target docker.service
Wants=network-online.target docker.service
# 포트 점유 등으로 반복 실패해도 무한 restart loop 금지(10회/2분 초과 시 failed 로 멈춤).
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
# 172.17.0.1:18000 을 다른 프로세스가 점유하면 CRITICAL + PID 기록 후 기동 중단(fail-safe).
ExecStartPre=/home/ubuntu/studyBridge/ops/studybridge-port-owner-check.sh 18000 172.17.0.1
# ai07 터널이 잠시 없어도 socat 자체는 살아 있고(연결 시점에 refused 반환) 폭주하지 않는다(fork 모델).
ExecStart=/usr/bin/socat TCP-LISTEN:18000,bind=172.17.0.1,reuseaddr,fork TCP:127.0.0.1:18000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
