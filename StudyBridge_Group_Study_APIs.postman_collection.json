			"item": [
				{
					"name": "회원 가입 (Register)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"testuser@studybridge.com\",\n  \"password\": \"password123\",\n  \"passwordConfirm\": \"password123\",\n  \"displayName\": \"테스트유저\",\n  \"major\": \"컴퓨터공학과\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/users/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
